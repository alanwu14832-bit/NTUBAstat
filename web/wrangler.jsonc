// Cloudflare Workers（靜態網站）設定：建置後把 dist/ 整個當網站發佈。
// Cloudflare 專案的 Root directory 要填 web，Deploy command 用 npx wrangler deploy。
// name 要和 Cloudflare 上的專案名稱一樣。
{
  "name": "ntubtstat",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // 單頁網站：/batting 這類網址都交給 index.html
    "not_found_handling": "single-page-application"
  }
}
